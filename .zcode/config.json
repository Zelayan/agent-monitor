{
  "hooks": {
    "enabled": true,
    "events": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "python3 /Users/chenzezeya/agent-monitor/scripts/reporter.py --event SessionStart --agent ZCode"
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "python3 /Users/chenzezeya/agent-monitor/scripts/reporter.py --event UserPromptSubmit --agent ZCode"
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": ".*",
          "hooks": [
            {
              "type": "command",
              "command": "python3 /Users/chenzezeya/agent-monitor/scripts/reporter.py --event PreToolUse --agent ZCode"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": ".*",
          "hooks": [
            {
              "type": "command",
              "command": "python3 /Users/chenzezeya/agent-monitor/scripts/reporter.py --event PostToolUse --agent ZCode"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "python3 /Users/chenzezeya/agent-monitor/scripts/reporter.py --event Stop --agent ZCode"
            }
          ]
        }
      ]
    }
  }
}
