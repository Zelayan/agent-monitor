{
  "name": "agent-monitor",
  "displayName": "Agent Monitor for Cursor",
  "description": "Real-time AI Coding Agent flight dashboard and lifecycle monitor embedded inside Cursor IDE",
  "version": "1.0.1",
  "publisher": "Zelayan",
  "icon": "assets/icon.png",
  "author": {
    "name": "Zelayan"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zelayan/agent-monitor"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "cursor",
    "agent",
    "monitor",
    "apm",
    "ai"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agent-monitor.openDashboard",
        "title": "Agent Monitor: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "agent-monitor.configureHooks",
        "title": "Agent Monitor: Configure Workspace Hooks (.cursor/hooks.json)",
        "icon": "$(gear)"
      },
      {
        "command": "agent-monitor.restoreHooks",
        "title": "Agent Monitor: Restore Workspace Hooks from Backup (.cursor/hooks.json.bak)",
        "icon": "$(history)"
      },
      {
        "command": "agent-monitor.restartDaemon",
        "title": "Agent Monitor: Restart Backend Daemon",
        "icon": "$(refresh)"
      },
      {
        "command": "agent-monitor.showDiagnostics",
        "title": "Agent Monitor: Run Diagnostics and Health Checks",
        "icon": "$(pulse)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-monitor-container",
          "title": "Agent Monitor",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "agent-monitor-container": [
        {
          "type": "webview",
          "id": "agent-monitor.sidebarView",
          "name": "Agent Monitor"
        }
      ]
    },
    "configuration": {
      "title": "Agent Monitor",
      "properties": {
        "agentMonitor.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Agent Monitor server endpoint URL"
        },
        "agentMonitor.apiKey": {
          "type": "string",
          "default": "",
          "description": "Optional API Key for authentication"
        },
        "agentMonitor.autoStartDaemon": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start background agent-monitor binary if not running"
        },
        "agentMonitor.statusBarEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Display live Agent timer and status indicator in Cursor status bar"
        },
        "agentMonitor.llmBaseUrl": {
          "type": "string",
          "default": "",
          "description": "OpenAI-compatible LLM base URL for session titles (e.g. http://127.0.0.1:11434/v1). Empty disables LLM titles unless set in the process environment."
        },
        "agentMonitor.llmModel": {
          "type": "string",
          "default": "",
          "description": "LLM model name for session titles (e.g. qwen2.5:7b or gpt-4o-mini). Empty disables LLM titles unless set in the process environment."
        },
        "agentMonitor.llmApiKey": {
          "type": "string",
          "default": "",
          "description": "Optional API key for the LLM endpoint (password field). Leave empty for local Ollama."
        },
        "agentMonitor.llmGoalEveryN": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 20,
          "description": "Refresh LLM session goalSummary every N completed runs. 0 disables goal summaries (card titles still update each run). Non-zero values are clamped to 1–20."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "package": "vsce package --no-dependencies",
    "test": "node test/runner.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}
