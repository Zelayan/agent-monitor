{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [{ "command": "bin/agent-reporter --event beforeSubmitPrompt --agent 'Cursor Agent'" }],
    "sessionStart": [{ "command": "bin/agent-reporter --event sessionStart --agent 'Cursor Agent'" }],
    "afterFileEdit": [{ "command": "bin/agent-reporter --event afterFileEdit --agent 'Cursor Agent'" }],
    "beforeShellExecution": [{ "command": "bin/agent-reporter --event beforeShellExecution --agent 'Cursor Agent'" }],
    "agentCompletion": [{ "command": "bin/agent-reporter --event agentCompletion --agent 'Cursor Agent'" }]
  }
}
